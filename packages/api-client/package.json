{
  "name": "@agro/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Tipos TypeScript e cliente HTTP gerados do contrato OpenAPI da API (openapi.json)",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "build": "pnpm run generate",
    "typecheck": "pnpm run generate && tsc --noEmit",
    "test": "echo \"sem testes\"",
    "verify": "pnpm run typecheck"
  },
  "dependencies": {
    "openapi-fetch": "0.15.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
