  "components": {
    "schemas": {
      "IdentityRequest": {
        "required": [
          "endereco",
          "inscricaoFiscal",
          "nome"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string",
            "description": "Nome",
            "example": "Fazenda Santa Clara"
          },
          "inscricaoFiscal": {
            "type": "string",
            "description": "CPF ou CNPJ, com ou sem máscara",
            "example": "11.222.333/0001-81"
          },
          "endereco": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "description": "Endereço",
            "example": "Rodovia BR-163, km 12, Sorriso/MT"
          }
        },
        "description": "Dados cadastrais de laboratório ou propriedade"
      },
      "PropertyResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 10
          },
          "nome": {
            "type": "string",
            "example": "Fazenda Santa Clara"
          },
          "inscricaoFiscal": {
            "type": "string",
            "description": "CPF ou CNPJ formatado",
            "example": "529.982.247-25"
          },
          "endereco": {
            "type": "string",
            "example": "Rodovia BR-163, km 12, Sorriso/MT"
          },
          "produtorId": {
            "type": "integer",
            "description": "Produtor dono; nulo quando a propriedade está disponível",
            "format": "int64",
            "nullable": true
          }
        },
        "description": "Propriedade rural"
      },
      "ProducerRequest": {
        "required": [
          "dataFinal",
          "dataInicial",
          "endereco",
          "inscricaoFiscal",
          "laboratorioId",
          "nome"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string",
            "example": "Maria Aparecida da Silva"
          },
          "inscricaoFiscal": {
            "type": "string",
            "description": "CPF ou CNPJ, com ou sem máscara",
            "example": "529.982.247-25"
          },
          "endereco": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "example": "Linha 5, lote 12, Lucas do Rio Verde/MT"
          },
          "dataInicial": {
            "type": "string",
            "description": "Início do período (ISO-8601)",
            "format": "date-time",
            "example": "2025-01-01T00:00:00Z"
          },
          "dataFinal": {
            "type": "string",
            "description": "Fim do período (ISO-8601)",
            "format": "date-time",
            "example": "2025-12-31T23:59:59Z"
          },
          "observacoes": {
            "type": "string",
            "description": "Observações livres",
            "nullable": true
          },
          "laboratorioId": {
            "type": "integer",
            "description": "Laboratório do produtor",
            "format": "int64",
            "example": 1
          },
          "propriedadeIds": {
            "uniqueItems": true,
            "type": "array",
            "description": "Propriedades a vincular (devem estar livres ou já ser do produtor)",
            "items": {
              "type": "integer",
              "description": "Propriedades a vincular (devem estar livres ou já ser do produtor)",
              "format": "int64"
            }
          }
        },
        "description": "Dados do produtor"
      },
      "LaboratoryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "nome": {
            "type": "string",
            "example": "Laboratório Solo Vivo"
          },
          "inscricaoFiscal": {
            "type": "string",
            "description": "CNPJ formatado",
            "example": "11.222.333/0001-81"
          },
          "endereco": {
            "type": "string",
            "example": "Av. das Análises, 100, Cuiabá/MT"
          }
        },
        "description": "Laboratório"
      },
      "ProducerResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 7
          },
          "nome": {
            "type": "string"
          },
          "inscricaoFiscal": {
            "type": "string",
            "description": "CPF ou CNPJ formatado",
            "example": "529.982.247-25"
          },
          "endereco": {
            "type": "string"
          },
          "dataInicial": {
            "type": "string",
            "format": "date-time",
            "example": "2025-01-01T00:00:00Z"
          },
          "dataFinal": {
            "type": "string",
            "format": "date-time",
            "example": "2025-12-31T23:59:59Z"
          },
          "observacoes": {
            "type": "string",
            "nullable": true
          },
          "laboratorio": {
            "$ref": "#/components/schemas/LaboratoryResponse"
          },
          "propriedades": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertySummary"
            }
          }
        },
        "description": "Produtor com laboratório e propriedades"
      },
      "PropertySummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "nome": {
            "type": "string"
          },
          "inscricaoFiscal": {
            "type": "string"
          },
          "endereco": {
            "type": "string"
          }
        },
        "description": "Propriedade embutida no produtor"
      },
      "PageResponseProducerResponse": {
        "type": "object",
