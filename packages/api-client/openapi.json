        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Página, a partir de 0",
            "required": false,
            "schema": {
              "minimum": 0,
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Itens por página (1 a 100)",
            "required": false,
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseProducerResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Produtores"
        ],
        "summary": "Cria um produtor",
        "description": "Exige laboratório existente; as propriedades informadas devem estar livres.",
        "operationId": "create_1",
        "requestBody": {
          "content": {
            "application/json": {
