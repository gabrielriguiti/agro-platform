                  "$ref": "#/components/schemas/ProducerResponse"
                }
              }
            }
          },
          "409": {
            "description": "Inscrição duplicada ou propriedade de outro produtor",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProducerResponse"
                }
              }
            }
          }
        }
      }
