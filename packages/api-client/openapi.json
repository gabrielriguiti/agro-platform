    "/api/laboratories/analytics": {
      "get": {
        "tags": [
          "Análise de laboratórios"
        ],
        "summary": "Analítico de laboratórios",
        "description": "Os filtros incidem sobre os produtores: totalProdutores conta só os que atendem a todos e qtdMinimaProdutores é aplicado a essa contagem. Datas em ISO-8601 (instante UTC).",
        "operationId": "analytics",
        "parameters": [
          {
            "name": "qtdMinimaProdutores",
            "in": "query",
            "description": "Quantidade mínima de produtores filtrados",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            },
            "example": 2
          },
          {
            "name": "dataInicialInicio",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "dataInicialFim",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "dataFinalInicio",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "dataFinalFim",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "buscaTexto",
            "in": "query",
            "description": "Busca parcial e literal (% _ \\ não são curingas) em observacoes",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Parâmetro ausente, fora do intervalo ou intervalo invertido",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LabAnalyticsResponse"
                  }
                }
              }
            }
          },
          "200": {
            "description": "Laboratórios com o total de produtores e o valor consolidado",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LabAnalyticsResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/integration/messages": {
      "get": {
        "tags": [
          "Integração"
        ],
        "summary": "Lista mensagens",
        "description": "Filtráveis por status e lote; o payload fica no detalhe.",
        "operationId": "messages",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "PROCESSING",
                "DONE",
                "DEAD"
              ]
            }
          },
          {
            "name": "batchId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MessagePage"
                }
              }
            }
          }
        }
      }
    },
    "/api/integration/messages/{id}": {
