  },
  "components": {
    "schemas": {
      "IdentityRequest": {
        "required": [
          "endereco",
          "inscricaoFiscal",
          "nome"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string",
            "description": "Nome",
            "example": "Fazenda Santa Clara"
          },
          "inscricaoFiscal": {
            "type": "string",
            "description": "CPF ou CNPJ, com ou sem máscara",
            "example": "11.222.333/0001-81"
          },
          "endereco": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "description": "Endereço",
            "example": "Rodovia BR-163, km 12, Sorriso/MT"
          }
        },
        "description": "Dados cadastrais de laboratório ou propriedade"
      },
      "PropertyResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 10
          },
          "nome": {
            "type": "string",
            "example": "Fazenda Santa Clara"
          },
          "inscricaoFiscal": {
            "type": "string",
            "description": "CPF ou CNPJ formatado",
            "example": "529.982.247-25"
          },
          "endereco": {
            "type": "string",
            "example": "Rodovia BR-163, km 12, Sorriso/MT"
          },
          "produtorId": {
            "type": "integer",
            "description": "Produtor dono; nulo quando a propriedade está disponível",
            "format": "int64",
            "nullable": true
          }
        },
        "description": "Propriedade rural"
      },
      "ProducerRequest": {
        "required": [
          "dataFinal",
          "dataInicial",
          "endereco",
          "inscricaoFiscal",
          "laboratorioId",
          "nome"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string",
            "example": "Maria Aparecida da Silva"
          },
          "inscricaoFiscal": {
            "type": "string",
            "description": "CPF ou CNPJ, com ou sem máscara",
            "example": "529.982.247-25"
          },
          "endereco": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "example": "Linha 5, lote 12, Lucas do Rio Verde/MT"
          },
          "dataInicial": {
            "type": "string",
            "description": "Início do período (ISO-8601)",
            "format": "date-time",
            "example": "2025-01-01T00:00:00Z"
          },
          "dataFinal": {
            "type": "string",
            "description": "Fim do período (ISO-8601)",
            "format": "date-time",
            "example": "2025-12-31T23:59:59Z"
          },
          "observacoes": {
            "type": "string",
            "description": "Observações livres",
            "nullable": true
          },
          "laboratorioId": {
            "type": "integer",
            "description": "Laboratório do produtor",
            "format": "int64",
            "example": 1
          },
          "propriedadeIds": {
            "uniqueItems": true,
            "type": "array",
            "description": "Propriedades a vincular (devem estar livres ou já ser do produtor)",
            "items": {
              "type": "integer",
              "description": "Propriedades a vincular (devem estar livres ou já ser do produtor)",
              "format": "int64"
            }
          }
        },
        "description": "Dados do produtor"
      },
      "LaboratoryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "nome": {
            "type": "string",
            "example": "Laboratório Solo Vivo"
          },
          "inscricaoFiscal": {
            "type": "string",
            "description": "CNPJ formatado",
            "example": "11.222.333/0001-81"
          },
          "endereco": {
            "type": "string",
            "example": "Av. das Análises, 100, Cuiabá/MT"
          }
        },
        "description": "Laboratório"
      },
      "ProducerResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 7
          },
          "nome": {
            "type": "string"
          },
          "inscricaoFiscal": {
            "type": "string",
            "description": "CPF ou CNPJ formatado",
            "example": "529.982.247-25"
          },
          "endereco": {
            "type": "string"
          },
          "dataInicial": {
            "type": "string",
            "format": "date-time",
            "example": "2025-01-01T00:00:00Z"
          },
          "dataFinal": {
            "type": "string",
            "format": "date-time",
            "example": "2025-12-31T23:59:59Z"
          },
          "observacoes": {
            "type": "string",
            "nullable": true
          },
          "laboratorio": {
            "$ref": "#/components/schemas/LaboratoryResponse"
          },
          "propriedades": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertySummary"
            }
          }
        },
        "description": "Produtor com laboratório e propriedades"
      },
      "PropertySummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "nome": {
            "type": "string"
          },
          "inscricaoFiscal": {
            "type": "string"
          },
          "endereco": {
            "type": "string"
          }
        },
        "description": "Propriedade embutida no produtor"
      },
      "WorkerRunResponse": {
        "type": "object",
        "properties": {
          "processed": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "Resultado de um ciclo do worker"
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "batchId": {
            "type": "integer",
            "format": "int64"
          },
          "type": {
            "type": "string"
          },
          "externalId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "attempts": {
            "type": "integer",
            "format": "int32"
          },
          "nextAttemptAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastError": {
            "type": "string"
          },
          "payload": {
            "type": "string",
            "nullable": true
          }
        },
        "description": "Mensagem da outbox"
      },
      "BatchRequest": {
        "required": [
          "items",
          "mergeStrategy",
          "source"
        ],
        "type": "object",
        "properties": {
          "source": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "Sistema parceiro de origem",
            "example": "erp-fazendas"
          },
          "mergeStrategy": {
            "pattern": "MERGE|OVERWRITE|KEEP_EXISTING",
            "type": "string",
            "description": "Estratégia de fusão com registros existentes",
            "example": "MERGE"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          }
        },
        "description": "Lote de integração"
      },
      "Item": {
        "required": [
          "externalId",
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "pattern": "PRODUCER|PROPERTY|LABORATORY",
            "type": "string",
            "example": "PRODUCER"
          },
          "externalId": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "example": "P-9"
          },
          "data": {
            "$ref": "#/components/schemas/JsonNode"
          }
        },
        "description": "Item do lote"
      },
      "JsonNode": {
        "type": "object",
        "description": "Conteúdo da entidade (objeto JSON)"
      },
      "BatchAcceptedResponse": {
        "type": "object",
        "properties": {
          "batchId": {
            "type": "integer",
            "format": "int64"
          },
          "accepted": {
            "type": "integer",
            "format": "int32"
          },
          "duplicates": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "Resultado da ingestão de um lote"
      },
      "ReprocessResponse": {
        "type": "object",
        "properties": {
          "requeued": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "Resultado do reprocessamento de um lote"
      },
      "PageResponseProducerResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProducerResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "Página de resultados"
      },
      "LabAnalyticsResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "nome": {
            "type": "string",
            "example": "LABORATÓRIO MODELO 1"
          },
          "totalProdutores": {
            "type": "integer",
            "format": "int32",
            "example": 4
          },
          "valorFinanceiroConsolidado": {
            "type": "number",
            "example": 600.0
          }
        },
        "description": "Laboratório com o total de produtores filtrados e o valor financeiro consolidado"
      },
      "MessagePage": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "Página de mensagens"
      },
      "BatchResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "source": {
            "type": "string"
          },
          "mergeStrategy": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "pending": {
            "type": "integer",
            "format": "int64"
          },
          "processing": {
            "type": "integer",
            "format": "int64"
          },
          "done": {
            "type": "integer",
            "format": "int64"
          },
          "dead": {
            "type": "integer",
            "format": "int64"
          },
          "state": {
            "type": "string"
          }
        },
        "description": "Resumo de um lote de integração"
      },
      "InfoResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome da aplicação",
            "example": "agro-api"
          }
        },
        "description": "Informações básicas da API"
      },
      "Componente": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "quantidade": {
            "type": "integer",
            "format": "int64"
          },
          "valorUnitario": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      },
      "FinancialResponse": {
        "type": "object",
        "properties": {
          "valor": {
            "type": "number",
            "example": 700.0
          },
          "natureza": {
            "type": "string",
            "example": "PRODUCER"
          },
          "componentes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Componente"
            }
          }
        },
        "description": "Valor financeiro calculado e as parcelas usadas"
      }
    }
  }
}
