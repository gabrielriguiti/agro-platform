# Copie para /opt/agro/.env na VPS (nunca versionado) e preencha. Valores abaixo são apenas exemplos.
GHCR_OWNER=seu-usuario-github-em-minusculas
PROXY_NETWORK=nome-da-rede-do-proxy
# Rede Docker do container Postgres (docker network ls); o agro-api entra nela para alcançar o banco.
DB_NETWORK=nome-da-rede-do-postgres
# Banco dedicado (database e role exclusivos). Tráfego interno à VPS, pela rede Docker: sem TLS.
# Se o banco ficar fora da VPS, use o host real e sslmode=verify-full.
DB_URL=jdbc:postgresql://postgres:5432/agro_demo?sslmode=disable
DB_USER=agro_demo
DB_PASSWORD=troque-esta-senha
SPRING_PROFILES_ACTIVE=demo
