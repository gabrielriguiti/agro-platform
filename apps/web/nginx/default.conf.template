server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Mesma origem para web e API: sem CORS. O nome "api" é o serviço do Compose (no prod, agro-api).
    location /api/ {
        resolver 127.0.0.11 valid=10s;
        set $upstream http://${API_HOST}:8080;
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/actuator/(health|info)$ {
        resolver 127.0.0.11 valid=10s;
        set $upstream http://${API_HOST}:8080;
        proxy_pass $upstream;
    }

    location / {
        try_files $uri /index.html;
    }
}
